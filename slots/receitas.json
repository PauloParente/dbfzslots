    },
    {
     "header": "CMDCEN05INP",
     "text": "^mAtk236;^mBtnX; or ^mBtnY; or ^mBtnB; while Stand OFF. (Stand Rush cancellable)"
    },
    {
     "header": "CMDCEN05T",
     "text": "[THE WORLD] performs the following attacks based on the buttons pressed: ^mBtnX;:An anti-air uppercut. ^mBtnY;:A downwards overhead punch. ^mBtnB;:An approaching low hitting punch"
    },
    {
     "header": "CMDCEN06",
