     "header": "CMDCEN08INP",
     "text": "^mAtk2;^mAtk2;^mBtnX; or ^mBtnY; or ^mBtnB; while Stand OFF."
    },
    {
     "header": "CMDCEN08T",
     "text": "Unblockable Command grab. DIO knocks down and drains the opponents blood, stealing a portion of health for himself."
    },
    {
     "header": "CMDCEN09",
     "text": "^aCMDGauge06;^aSpecial;Useless, useless, useless, useless!"
