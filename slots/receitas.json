    {
     "header": "CMDCEN12INP",
     "text": "^mAtk2;^mAtk2;^mBtnX; or ^mBtnY; or ^mBtnB; while Stand ON."
    },
    {
     "header": "CMDCEN12T",
     "text": "After a brief delay, [THE WORLD] stops time and delivers an unblockable punch."
